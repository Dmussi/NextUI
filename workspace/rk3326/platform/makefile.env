# rk3326 (Powkiddy V10 on ArkOS)
# Built with workspace/rk3326/toolchain (zig cc, aarch64 glibc 2.28).
# no -ffast-math: clang (unlike gcc -Ofast) then treats NextUI's INFINITY
# checks as undefined behaviour
OPT = -O3 -fomit-frame-pointer
CFLAGS = -mcpu=cortex-a35
SDL = SDL2
GL = GLES
CFLAGS += -I$(PREFIX_LOCAL)/include -I$(PREFIX)/include
LDFLAGS = -L$(PREFIX_LOCAL)/lib -L$(PREFIX)/lib
# pkg-config
export PKG_CONFIG_LIBDIR := $(PREFIX_LOCAL)/lib/pkgconfig:$(PREFIX)/lib/pkgconfig
CFLAGS += $$(pkg-config --cflags sdl2 glesv2)
LDFLAGS += $$(pkg-config --libs sdl2) -lGLESv2
# not handled by pkg-config
CFLAGS += -DUSE_$(SDL) -DUSE_$(GL) -DGL_GLEXT_PROTOTYPES
LDFLAGS += -l$(SDL)_image -l$(SDL)_ttf -lsamplerate -lpthread -ldl -lm -lz
