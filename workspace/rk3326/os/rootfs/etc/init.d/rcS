#!/bin/sh
# NextUI OS: system start (before NextUI)
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t tmpfs -o mode=755 tmpfs /run
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
mkdir -p /tmp/var/log /tmp/var/tmp
echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null
hostname -F /etc/hostname

LOG=/tmp/boot.log
# segfaults: let the kernel log the faulting program, address and registers
echo 1 > /proc/sys/debug/exception-trace 2>/dev/null
t() { echo "rcS: $1 $(cut -d' ' -f1 /proc/uptime)"; }
{
	echo "rcS: $(cat /proc/uptime)"
	# clock from the rk817 RTC
	t hwclock
	hwclock -s -u 2>&1
	t timezone
	# time zone saved by NextUI's settings
	TZFILE=/mnt/SDCARD/.userdata/rk3326/timezone
	TZNAME=$(cat "$TZFILE" 2>/dev/null)
	[ -f "/usr/share/zoneinfo/$TZNAME" ] || TZNAME=UTC
	cp "/usr/share/zoneinfo/$TZNAME" /tmp/localtime
	echo "$TZNAME" > /tmp/timezone
	t audio
	# speaker on, then follow the headphone jack. The V10's jack switch reads
	# "plugged in" with nothing plugged in, so its meaning is inverted.
	amixer -q -c 0 sset 'Playback Path' SPK
	amixer --invert --hp-watch >> /tmp/hp.log 2>&1 &
	# memory clock changes stall the bus and make the sound crackle: pin the
	# memory controller to its top speed (this kernel has no "performance"
	# governor for it, so use "userspace" with the highest frequency)
	d=/sys/class/devfreq/dmc
	if [ -d $d ]; then
		echo "dmc: $(cat $d/governor) $(cat $d/cur_freq) freqs: $(cat $d/available_frequencies)"
		top=$(tr ' ' '\n' < $d/available_frequencies | grep -v '^$' | sort -n | tail -1)
		echo userspace > $d/governor 2>/dev/null && echo "$top" > $d/userspace/set_freq 2>/dev/null
		echo "$top" > $d/min_freq 2>/dev/null
		echo "dmc now: $(cat $d/governor) $(cat $d/cur_freq)"
	fi
	echo "cpu governor: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null) avail: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors 2>/dev/null)"
	# performance log every 15 s (CPU, memory, GPU clocks, temperature),
	# so slowdowns can be traced
	(
		while :; do
			echo "$(cut -d' ' -f1 /proc/uptime) cpu=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null)/$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null) max=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null) dmc=$(cat /sys/class/devfreq/dmc/cur_freq 2>/dev/null) gpu=$(cat /sys/class/devfreq/ff400000.gpu/cur_freq 2>/dev/null) temp=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null) load=$(cut -d' ' -f1-3 /proc/loadavg)"
			sleep 15
		done >> /tmp/perf.log 2>&1
	) &
	echo "rcS: done $(cat /proc/uptime)"
} >> $LOG 2>&1
